# Starlink Overage Dashboard — environment configuration.
# Copy to ".env" (in the backend working dir) and fill in real values.

# --- Mode -------------------------------------------------------------------
# Set to 1/true to force synthetic data. If credentials below are blank the app
# automatically runs in mock mode regardless of this setting.
MOCK_MODE=false

# --- Starlink API v2 credentials (OAuth2 client credentials) ----------------
STARLINK_CLIENT_ID=
STARLINK_CLIENT_SECRET=
STARLINK_ACCOUNT_NUMBER=

# Override only if Starlink changes endpoints.
STARLINK_TOKEN_URL=https://www.starlink.com/api/auth/connect/token
STARLINK_API_BASE=https://web-api.starlink.com
# API version segment (v1 was deprecated 2026-05-01; use v2).
STARLINK_API_VERSION=v2

# --- Polling ----------------------------------------------------------------
POLL_INTERVAL_SECONDS=3600
POLL_PAGE_SIZE=100
POLL_ON_STARTUP=true

# --- Overage accounting -----------------------------------------------------
WARNING_THRESHOLD_PCT=80
OVERAGE_COST_PER_GB=1.00

# --- Storage ----------------------------------------------------------------
DATABASE_URL=sqlite:///./starlink_dashboard.db
